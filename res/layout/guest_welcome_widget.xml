<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome card (4x1) — GuestWelcomeWidget. Texts, logo and which views show are set at
     update time. Only RemoteViews-safe views (LinearLayout, FrameLayout, ViewFlipper,
     ImageView, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guest_welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/guest_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- The venue's logo once the MDM client has it; else the storefront badge below. -->
    <FrameLayout
        android:id="@+id/guest_welcome_logo_box"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/guest_logo_bg"
        android:visibility="gone">

        <ImageView
            android:id="@+id/guest_welcome_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/guest_welcome_badge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/guest_icon_gradient">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/guest_ic_storefront" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- "Welcome to <restaurant>" in English, Spanish, French and German, 3 s each. -->
        <ViewFlipper
            android:id="@+id/guest_welcome_titles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoStart="true"
            android:flipInterval="3000"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <TextView
                android:id="@+id/guest_welcome_title"
                style="@style/GuestWelcomeTitle"
                android:text="@string/guest_welcome_title_plain" />

            <TextView
                android:id="@+id/guest_welcome_title_es"
                style="@style/GuestWelcomeTitle" />

            <TextView
                android:id="@+id/guest_welcome_title_fr"
                style="@style/GuestWelcomeTitle" />

            <TextView
                android:id="@+id/guest_welcome_title_de"
                style="@style/GuestWelcomeTitle" />
        </ViewFlipper>

        <!-- No restaurant assigned: one fixed line instead of the flipper. -->
        <TextView
            android:id="@+id/guest_welcome_plain"
            style="@style/GuestWelcomeTitle"
            android:text="@string/guest_not_deployed"
            android:visibility="gone" />

        <TextView
            android:id="@+id/guest_welcome_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="aio-sans"
            android:maxLines="1"
            android:text="@string/guest_welcome_subtitle"
            android:textColor="@color/guest_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/guest_welcome_go"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/guest_round_button"
        android:contentDescription="@string/guest_welcome_subtitle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/guest_ic_arrow" />
    </FrameLayout>
</LinearLayout>
