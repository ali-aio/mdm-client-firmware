<?xml version="1.0" encoding="utf-8"?>
<!-- Guest Wi-Fi card: the widget's glass, nearly opaque so the QR code reads on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/guest_card_solid" />
    <stroke android:width="1dp" android:color="@color/guest_card_edge" />
    <corners android:radius="28dp" />
</shape>
